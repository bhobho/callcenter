# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Anthropic Configuration
ANTHROPIC_API_KEY=your_api_key

# Deepgram Configuration (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_key

# ElevenLabs Configuration (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_key

# Server Configuration
# Port 8000 is often taken by Docker on macOS; using 8080 to avoid conflicts
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Call Center Configuration
# Options: customer_service, technical_support, appointment_scheduling, billing, sales
CALL_CENTER_TYPE=customer_service

# ElevenLabs Voice ID (default: Bella)
VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Maximum call duration in seconds (default: 3600 = 1 hour)
MAX_CALL_DURATION=3600

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
